  {
    "slug": "lil-bebs",
    "title": "Lil Bebs",
    "year": "2023",
    "yearNum": 2023,
    "category": "exhibition",
    "medium": "",
    "dimensions": "",
    "series": "",
    "description": "Lil Bebs explores the relationship between scale, patience, and process. Working on a more intimate scale challenged me to slow down and approach each sculpture with greater precision and restraint. Rather than relying on physical force or monumentality, these works emerged through sustained attention, where small gestures, subtle shifts, and repeated actions gradually accumulated into form. Like tending a garden, these works could not be rushed. They developed through time, care, and repetition, becoming reflections on the quiet labor of making and on the ways growth unfolds through patience rather than force.",
    "venue": "Louis Buhl & Co.",
    "city": "Detroit, MI",
    "images": [
